options="[1]Shutdown\n[2]Reboot\n[3]Suspend\n[4]Logout\n[5]Lock"

chosen=$(echo -e "$options" | rofi -dmenu -i -p "" -theme-str 'inputbar {enabled: false;} window {width: 15%;}')

case "$chosen" in
	[1]Shutdown)
		systemctl poweroff
		;;
	[2]Reboot)
		systemctl reboot
		;;
	[3]Suspend)
		systemctl suspend
		;;
	[4]Logout)
		niri msg action quit
		;;
	[5]Lock)
		swaylock
		;;
	*)
		exit
		;;
esac
