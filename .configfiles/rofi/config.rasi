configuration {
	terminal: "kitty";
	display-run: " ";
	display-drun: "";
	fixed-num-lines: false;
}

@import "colors"

scrollbar {
	width: 0;
	handle-width: 0;
}

window {
	width: 30%;
	height: 45%;
	background-color: black/0%;
	border: 0;
	children: [mainbox];
}

mainbox {
	y-offset: 0%;
	location: center;
	anchor: north;
	spacing: 3;
	background-color: @transparent;
	border: 0;
	transparency: "real";
	children: [inputbar, listview];
}

inputbar {
	background-color: @bg;
	text-color: @fg;
	children: [prompt, entry];
}

prompt {
	background-color: @transparent;
	text-color: @fg;
	padding: 0.5em 0.5em 0.5em 0.5em;
	border: 0;
}

entry {
	background-color: @transparent;
	text-color: @fg;
	placeholder: "";
	padding: 0.5em 0 0.5em 0;
	border: 0;
}

listview {
	background-color: @transparent;
	cycle: false;
	dynamic: true;
	padding: 0 0 0 0;
	border: 0;
	columns: 1;
	spacing: 0;
	margin: 0;
	padding: 20;
	children: [element];
}

element {
	padding: 0px;
	border: 0;
}

element selected {
	background-color: @transparent;
	text-color: @fg;
	border: 0;
}

element-text {
	background-color: @bg	;
	text-color: @fg;
	padding: 0.25em 0.2em 0.25em 0.2em;
	border: 0;
}

element-text selected {
	background-color: @bg2;
	text-color: @fg;
	padding: 0.2em 0.2em 0.2em 0.2em;
	border: 0;
}
